{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-kb:script:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "core_version": {
      "type": "string",
      "minLength": 1
    },
    "niche_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "draft",
        "approved"
      ]
    },
    "brief": {
      "type": "string",
      "minLength": 1
    },
    "promise": {
      "type": "string",
      "minLength": 1
    },
    "duration_target_seconds": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "protected_elements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "start_state": {
            "type": "string",
            "minLength": 1
          },
          "end_state": {
            "type": "string",
            "minLength": 1
          },
          "beats": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "visual": {
                  "type": "string",
                  "minLength": 1
                },
                "audio": {
                  "type": "string",
                  "minLength": 1
                },
                "speech": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "information_change": {
                  "type": "string",
                  "minLength": 1
                },
                "intended_response": {
                  "type": "string",
                  "minLength": 1
                },
                "duration_target_seconds": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "core_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                }
              },
              "required": [
                "id",
                "visual",
                "audio",
                "speech",
                "information_change",
                "intended_response",
                "duration_target_seconds",
                "core_ids"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "objective",
          "start_state",
          "end_state",
          "beats"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "acceptance_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "viewer_tested": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "id",
    "core_version",
    "niche_id",
    "status",
    "brief",
    "promise",
    "duration_target_seconds",
    "protected_elements",
    "segments",
    "assumptions",
    "acceptance_checks",
    "viewer_tested"
  ],
  "additionalProperties": false
}
