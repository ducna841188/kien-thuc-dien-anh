{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-kb:knowledge:1.1.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[0-9]{3}$"
    },
    "namespace": {
      "const": "film.core"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "module_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "co_ban",
        "trung_cap",
        "nang_cao"
      ]
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_kind": {
      "type": "string",
      "minLength": 1
    },
    "decision_question": {
      "type": "string",
      "minLength": 1
    },
    "use_when": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "principle": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "original_example": {
      "type": "string",
      "minLength": 1
    },
    "counterexample": {
      "type": "string",
      "minLength": 1
    },
    "prerequisite_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "evidence_policy": {
      "type": "object",
      "properties": {
        "basis": {
          "const": "editorial_synthesis_with_scoped_references"
        },
        "audience_effect": {
          "const": "conditional_hypothesis"
        },
        "generation_tested": {
          "type": "boolean"
        },
        "viewer_tested": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "basis",
        "audience_effect",
        "generation_tested",
        "viewer_tested",
        "note"
      ],
      "additionalProperties": false
    },
    "updated_on": {
      "type": "string",
      "minLength": 1
    },
    "application_depth": {
      "type": "object",
      "properties": {
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "worked_example": {
          "type": "object",
          "properties": {
            "brief": {
              "type": "string",
              "minLength": 1
            },
            "protected_elements": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "option_a": {
              "type": "string",
              "minLength": 1
            },
            "option_b": {
              "type": "string",
              "minLength": 1
            },
            "selection_rule": {
              "type": "string",
              "minLength": 1
            },
            "observable_checks": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "brief",
            "protected_elements",
            "option_a",
            "option_b",
            "selection_rule",
            "observable_checks"
          ],
          "additionalProperties": false
        },
        "failure_diagnosis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "symptom": {
                "type": "string",
                "minLength": 1
              },
              "possible_causes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "next_test": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "symptom",
              "possible_causes",
              "next_test"
            ],
            "additionalProperties": false
          }
        },
        "evidence_links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "scope_limit": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "source_id",
              "claim",
              "scope_limit"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "mechanism",
        "worked_example",
        "failure_diagnosis",
        "evidence_links"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "namespace",
    "version",
    "module_id",
    "title",
    "level",
    "status",
    "knowledge_kind",
    "decision_question",
    "use_when",
    "principle",
    "actions",
    "tradeoffs",
    "verification",
    "original_example",
    "counterexample",
    "prerequisite_ids",
    "related_ids",
    "source_ids",
    "evidence_policy",
    "updated_on"
  ],
  "additionalProperties": false,
  "$comment": "Bổ sung application_depth tùy chọn; các bản ghi kiến thức 1.0.0 vẫn hợp lệ. Các hợp đồng phân tích/tác vụ khác vẫn giữ 1.0.0."
}
