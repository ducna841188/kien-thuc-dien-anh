{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-kb:niche:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "core_dependency": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest_url": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repository",
        "version",
        "commit",
        "manifest_url"
      ],
      "additionalProperties": false
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "blob_sha": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "path",
          "revision",
          "blob_sha",
          "scope"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "audience": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "promise": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "target_hypothesis",
            "measured"
          ]
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "target",
        "promise",
        "status",
        "unknowns"
      ],
      "additionalProperties": false
    },
    "confirmed_choices": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "core_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "context": {
            "type": "string",
            "minLength": 1
          },
          "application": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "acceptance_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "status": {
            "enum": [
              "user_decision",
              "editorial_hypothesis",
              "video_observation",
              "tested"
            ]
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "limits": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "core_ids",
          "context",
          "application",
          "acceptance_checks",
          "status",
          "source_refs",
          "limits"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "corpus": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "media_review_state": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "path",
          "revision",
          "media_review_state",
          "limitations"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "promotion_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "core_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "counterexample": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "candidate",
              "ready_for_review",
              "proposed_reversal",
              "accepted",
              "rejected"
            ]
          }
        },
        "required": [
          "id",
          "core_ids",
          "claim",
          "evidence_refs",
          "conditions",
          "counterexample",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "updated_on": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "version",
    "title",
    "core_dependency",
    "source_refs",
    "audience",
    "confirmed_choices",
    "rules",
    "corpus",
    "promotion_candidates",
    "updated_on"
  ],
  "additionalProperties": false
}
