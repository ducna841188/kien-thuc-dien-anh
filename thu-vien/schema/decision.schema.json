{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:film-kb:decision:1.0.0",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "task": {
      "enum": [
        "analyze_video",
        "write_script",
        "design_shots",
        "write_generation_prompts",
        "diagnose_and_repair"
      ]
    },
    "core_version": {
      "type": "string",
      "minLength": 1
    },
    "niche_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "brief": {
      "type": "string",
      "minLength": 1
    },
    "known_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "unknown_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "protected_elements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "knowledge_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "proposal": {
            "type": "string",
            "minLength": 1
          },
          "why": {
            "type": "string",
            "minLength": 1
          },
          "tradeoffs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "proposal",
          "why",
          "tradeoffs",
          "requirements"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "selected_option_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "implementation_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "acceptance_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "observable": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "not_tested",
              "passed",
              "failed",
              "unknown"
            ]
          }
        },
        "required": [
          "observable",
          "method",
          "status"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "change_log": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "tested_on_generated_video": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "id",
    "task",
    "core_version",
    "niche_id",
    "brief",
    "known_inputs",
    "unknown_inputs",
    "protected_elements",
    "knowledge_refs",
    "options",
    "selected_option_id",
    "implementation_steps",
    "acceptance_checks",
    "assumptions",
    "change_log",
    "tested_on_generated_video"
  ],
  "additionalProperties": false
}
